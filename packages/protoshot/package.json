{
  "name": "protoshot",
  "version": "0.0.1",
  "description": "Turn UI source code into a screenshot, for coding agents.",
  "license": "MIT",
  "author": "Vaibhav Shinde (https://github.com/vaibhavshn)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaibhavshn/protoshot.git"
  },
  "bin": {
    "protoshot": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "oxc-parser": "^0.153.0",
    "playwright-core": "^1.64.0",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bumpp": "^11.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  }
}
